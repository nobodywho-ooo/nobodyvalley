# Local, non-committed settings: save names, farmer names, remote machine.
# Copy this file to scripts/local.env (gitignored) and fill in your own values.
# Environment variables of the same name win over the file.
#
#   NV_SAVE        save folder to host (demo.sh)
#   NV_FARMHANDS   space-separated farmhand names, matching the save's cabins
#   NV_TEST_SAVE   source save for test-instance.sh
#   NV_MODEL       default model for farmers without a `model` key in their persona:
#                  gemma4-e2b, gemma4-12b, qwen3.5-9b (default), or qwen3.8-flash-next
#                  (runs on the ASCENTs, see ../on-prem). Each local farmer loads its own
#                  copy of its model's weights, so mind total RAM.
#   NV_VLLM_URL    OpenAI-compatible endpoint for qwen3.8-flash-next
#                  (default: http://ascent1.local:8000/v1)
#   NV_VLLM_API_KEY  the ASCENTs' vLLM API key. Get it in ../on-prem:
#                  sops k3s/ascent-secrets.sops.yaml  (needs the team age key from Bitwarden)
#                  or: kubectl --context ascent1 -n chat get secret shared-secrets \
#                      -o jsonpath='{.data.VLLM_API_KEY}' | base64 -d
#   NV_REMOTE      user@host to deploy to (deploy.sh)
#   NV_REMOTE_DIR  project folder on the remote machine, relative to its home
#   NV_STALE_AFTER  seconds of silence from a game instance before the agent watchdog calls it
#                   hung and probes it (agents; default 300)
#   NV_WATCHDOG_KILL  1 to let the watchdog kill a farmhand instance once it's confirmed hung, so
#                   the co-op continues without it (never the host)

NV_SAVE="Farm_123456789"
NV_FARMHANDS="Alice Bob Charlie David"
NV_TEST_SAVE="Farm_123456789"
NV_REMOTE="user@host"
NV_REMOTE_DIR="nobodyvalley"
